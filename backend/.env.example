# 阶段二（工单17）环境配置 · 严格对齐 docs/01-技术栈选型总表
# 复制为 .env 使用

APP_NAME=文旅创新智脑 · 多模态文旅知识检索与生成
API_PREFIX=/api/v1
DEBUG=true

# ---------------- 数据层 ----------------
DATABASE_URL=postgresql+psycopg2://wenlv:wenlv_pass@127.0.0.1:5432/wenlv
DB_SCHEMA=wenlv

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=wenlv_kb
MILVUS_METRIC=COSINE
MILVUS_INDEX_TYPE=HNSW
MILVUS_HNSW_M=16
MILVUS_HNSW_EF_CONSTRUCTION=200
MILVUS_SEARCH_EF=64

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=wenlv
MINIO_SECRET_KEY=wenlv_minio_pass
MINIO_BUCKET=wenlv-media
MINIO_SECURE=false

# ---------------- 硅基流动 SiliconFlow API ----------------
# BGE-M3 向量化 / bge-reranker-v2-m3 重排 / Qwen 生成 / FunASR(SenseVoice) 识别 / CosyVoice 合成
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SF_EMBEDDING_MODEL=BAAI/bge-m3
SF_EMBEDDING_DIM=1024
SF_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
SF_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
SF_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
SF_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
SF_TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:anna

# cloud=SiliconFlow API（默认） | local=本地权重
EMBEDDING_MODE=cloud
RERANKER_MODE=cloud
LLM_MODE=cloud
ASR_MODE=cloud
TTS_MODE=cloud
CLIP_MODE=local

# ---------------- 本地权重（仅 CLIP 与可选的 local 模式使用）----------------
MODEL_DIR=../models
BGE_M3_PATH=../models/bge-m3
CLIP_PATH=../models/chinese-clip
RERANKER_PATH=BAAI/bge-reranker-v2-m3
QWEN_SERVING=local
QWEN_MODEL_PATH=../models/qwen2.5-1.5b-instruct
QWEN_BASE_URL=http://127.0.0.1:8000/v1
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_MAX_NEW_TOKENS=512

# ---------------- OCR / 语音 ----------------
PADDLEOCR_LANG=ch
PADDLEOCR_USE_GPU=false
FUNASR_MODEL=paraformer-zh
COSYVOICE_ENDPOINT=http://127.0.0.1:9880

# ---------------- 检索参数 ----------------
TOP_K=10
RERANK_TOP_N=3

# ---------------- 安全：OAuth2 + JWT + RBAC ----------------
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
ADMIN_USERNAME=admin
ADMIN_PASSWORD=wenlv_admin_pass

# ---------------- 内容安全 ----------------
CONTENT_BLOCKLIST=
